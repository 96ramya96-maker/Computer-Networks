#include <sys/types.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <time.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <signal.h>
#include <sys/wait.h>

#define PORT 8891
#define MAX_OPERANDS 10

typedef struct {
    char operator_str[16];
    int operands[MAX_OPERANDS];
    int num_operands;
} RPCRequest;

typedef struct {
    int result;
    char timestamp[32];
    int status;
} RPCResponse;

void handle_sigchld(int sig) {
    (void)sig;
    while (waitpid(-1, NULL, WNOHANG) > 0);
}

void handle_rpc_request(int sockfd, RPCRequest req, struct sockaddr_in client_addr, socklen_t addr_len) {
    RPCResponse res;
    time_t raw_time;
    struct tm *time_info;
    int i; // Declared here for ANSI C / C89 compatibility

    memset(&res, 0, sizeof(res));

    raw_time = time(NULL);
    time_info = localtime(&raw_time);
    strftime(res.timestamp, sizeof(res.timestamp), "%Y-%m-%d %H:%M:%S", time_info);

    res.status = 0;

    if (strcmp(req.operator_str, "add") == 0) {
        if (req.num_operands < 1) {
            res.status = -3;
        } else {
            res.result = 0;
            for (i = 0; i < req.num_operands; i++) {
                res.result += req.operands[i];
            }
        }
    }
    else if (strcmp(req.operator_str, "sub") == 0) {
        if (req.num_operands < 2) {
            res.status = -3;
        } else {
            res.result = req.operands[0];
            for (i = 1; i < req.num_operands; i++) {
                res.result -= req.operands[i];
            }
        }
    }
    else if (strcmp(req.operator_str, "mul") == 0) {
        if (req.num_operands < 1) {
            res.status = -3;
        } else {
            res.result = 1;
            for (i = 0; i < req.num_operands; i++) {
                res.result *= req.operands[i];
            }
        }
    }
    else if (strcmp(req.operator_str, "div") == 0) {
        if (req.num_operands != 2) {
            res.status = -4;
        } else if (req.operands[1] == 0) {
            res.status = -2;
        } else {
            res.result = req.operands[0] / req.operands[1];
        }
    }
    else {
        res.status = -1;
    }

    sleep(2);

    sendto(sockfd, &res, sizeof(res), 0, (struct sockaddr*)&client_addr, addr_len);

    if (res.status == 0) {
        printf("[Child %d] Handled '%s' (%d params) at %s. Result: %d\n",
               getpid(), req.operator_str, req.num_operands, res.timestamp, res.result);
    } else {
        printf("[Child %d] Failed request '%s' at %s. Status error: %d\n",
               getpid(), req.operator_str, res.timestamp, res.status);
    }
    exit(0);
}

int main() {
    int sockfd;
    struct sockaddr_in server_addr, client_addr;
    socklen_t addr_len = sizeof(client_addr);
    RPCRequest req;
    struct sigaction sa;

    sa.sa_handler = handle_sigchld;
    sigemptyset(&sa.sa_mask);
    sa.sa_flags = SA_RESTART | SA_NOCLDSTOP;
    sigaction(SIGCHLD, &sa, NULL);

    if ((sockfd = socket(AF_INET, SOCK_DGRAM, 0)) < 0) {
        perror("Socket failed");
        exit(EXIT_FAILURE);
    }

    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(PORT);

    if (bind(sockfd, (const struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
        perror("Bind failed");
        close(sockfd);
        exit(EXIT_FAILURE);
    }

    printf("Concurrent UDP RPC Server running on port %d...\n", PORT);

    while (1) {
        ssize_t n = recvfrom(sockfd, &req, sizeof(req), 0, (struct sockaddr*)&client_addr, &addr_len);
        if (n < 0) continue;

        pid_t pid = fork();
        if (pid == 0) {
            handle_rpc_request(sockfd, req, client_addr, addr_len);
        }
    }

    close(sockfd);
    return 0;
}
