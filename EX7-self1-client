#include <arpa/inet.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/socket.h>
#include <netinet/in.h>
#define PORT 5001
#define BUF 2048
int main(void) {
    int s=socket(AF_INET,SOCK_STREAM,0); if(s<0){perror("socket");return 1;}
    struct sockaddr_in a={0}; a.sin_family=AF_INET; a.sin_port=htons(PORT); inet_pton(AF_INET,"127.0.0.1",&a.sin_addr);
    if(connect(s,(struct sockaddr*)&a,sizeof a)<0){perror("connect");return 1;}
    char buf[BUF], input[512];
    while(1) {
        ssize_t n=recv(s,buf,sizeof(buf)-1,0); if(n<=0)break; buf[n]='\0'; fputs(buf,stdout); fflush(stdout);
        if(strstr(buf,"Username: ")||strstr(buf,"Password: ")||strstr(buf,"Your answer (A/B/C/D): ")) {
            if(!fgets(input,sizeof input,stdin))break;
            send(s,input,strlen(input),0);
        }
        if(strstr(buf,"Final score:")||strstr(buf,"Disconnecting."))break;
    }
    close(s); return 0;
}
