import sys

def solve():
    input = sys.stdin.read
    data = input().split()
    
    if not data:
        return
        
    t = int(data[0])
    results = []
    
    for i in range(1, t + 1):
        s = data[i]
        # Sum the integer value of each character if it is a digit
        digit_sum = sum(int(char) for char in s if char.isdigit())
        results.append(str(digit_sum))
        
    print('\n'.join(results))

if __name__ == '__main__':
    solve()
