#include <stdio.h>
#include <stdlib.h>

#define MAX 10
#define INF 9999

// Node structure for the Adjacency List (Represents a Link/Edge)
struct Node 
{
    int dest;
    int weight;
    struct Node* next;
};

// Routing Table structure for each router
struct RoutingTable
{
    int cost[MAX];
    int nextHop[MAX];
};

// Global variables
int routers;
struct Node* adjList[MAX]; // Adjacency list representation of the network graph
struct RoutingTable table[MAX];

// Function Prototypes
void getInput();
void addEdge(int src, int dest, int weight);
void initializeRoutingTable();
void displayCostMatrix();
void displayInitialTables();
void displayNeighbours();
void sendRoutingTables();
void runDistanceVector();
void displayRoutingTables();
void displayFinalTables();
void freeGraph();

int main()
{
    getInput();
    displayCostMatrix();
    initializeRoutingTable();
    displayInitialTables();
    displayNeighbours();
    runDistanceVector();
    displayFinalTables();
    freeGraph(); // Clean up dynamic memory

    return 0;
}

// Function to add a connection in the adjacency list
void addEdge(int src, int dest, int weight) 
{
    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
    newNode->dest = dest;
    newNode->weight = weight;
    newNode->next = adjList[src];
    adjList[src] = newNode;
}

void getInput()
{
    int i, j, weight;
    printf("Enter Number of Routers : ");
    if (scanf("%d", &routers) != 1) return;

    // Initialize adjacency list to NULL
    for(i = 0; i < routers; i++) {
        adjList[i] = NULL;
    }

    printf("\nEnter Cost Matrix\n");
    printf("(Enter 9999 if routers are not directly connected)\n\n");

    for(i = 0; i < routers; i++)
    {
        for(j = 0; j < routers; j++)
        {
            if (scanf("%d", &weight) != 1) return;
            // Only add valid structural edges to the adjacency list
            if (weight != INF && i != j) {
                addEdge(i, j, weight);
            }
        }
    }
}

// Helper function to find edge cost from adjacency list
int getLinkCost(int src, int dest) 
{
    if (src == dest) return 0;
    struct Node* temp = adjList[src];
    while (temp != NULL) {
        if (temp->dest == dest) {
            return temp->weight;
        }
        temp = temp->next;
    }
    return INF;
}

void displayCostMatrix()
{
    int i, j;
    printf("\n==============================\n");
    printf("        COST MATRIX\n");
    printf("==============================\n\n");

    for(i = 0; i < routers; i++)
    {
        for(j = 0; j < routers; j++)
        {
            int cost = getLinkCost(i, j);
            if(cost == INF)
                printf("INF\t");
            else
                printf("%d\t", cost);
        }
        printf("\n");
    }
}

void initializeRoutingTable()
{
    int i, j;
    for(i = 0; i < routers; i++)
    {
        for(j = 0; j < routers; j++)
        {
            int linkCost = getLinkCost(i, j);
            table[i].cost[j] = linkCost;

            if(i == j) {
                table[i].nextHop[j] = i;
            }
            else if(linkCost != INF) {
                table[i].nextHop[j] = j;
            }
            else {
                table[i].nextHop[j] = -1;
            }
        }
    }
}

void displayInitialTables()
{
    printf("\n==========================================");
    printf("\n        INITIAL ROUTING TABLES");
    printf("\n==========================================\n");
    displayRoutingTables();
}

void displayNeighbours()
{
    int i;
    printf("\n==========================================");
    printf("\n       DIRECT NEIGHBOURS");
    printf("\n==========================================\n");

    for(i = 0; i < routers; i++)
    {
        printf("\nRouter %c : ", 'A' + i);
        struct Node* temp = adjList[i];
        // Directly traverse the linked list of neighbors
        while(temp != NULL) {
            printf("%c ", 'A' + temp->dest);
            temp = temp->next;
        }
        printf("\n");
    }
}

void sendRoutingTables()
{
    int i;
    printf("\n==========================================");
    printf("\n      SENDING ROUTING TABLES");
    printf("\n==========================================\n");

    for(i = 0; i < routers; i++)
    {
        struct Node* temp = adjList[i];
        while(temp != NULL) {
            printf("\nRouter %c sends Routing Table to Router %c", 'A' + i, 'A' + temp->dest);
            temp = temp->next;
        }
    }
    printf("\n");
}

void runDistanceVector()
{
    int i, j;
    int iteration = 1;
    int updated;

    do
    {
        updated = 0;
        printf("\n==========================================");
        printf("\n          ITERATION %d", iteration);
        printf("\n==========================================\n");

        sendRoutingTables();

        printf("\n------------------------------------------");
        printf("\nReceiving Routing Tables");
        printf("\n------------------------------------------\n");

        for(i = 0; i < routers; i++)
        {
            // Instead of searching all routers, only look at direct neighbors (incoming links)
            struct Node* neighbor = adjList[i];
            while(neighbor != NULL)
            {
                int k = neighbor->dest;
                int costToNeighbor = neighbor->weight;

                printf("\nRouter %c receives Routing Table from Router %c\n", 'A' + i, 'A' + k);

                for(j = 0; j < routers; j++)
                {
                    if(table[k].cost[j] == INF)
                        continue;

                    int newCost = costToNeighbor + table[k].cost[j];

                    if(newCost < table[i].cost[j])
                    {
                        printf("\nUpdating Router %c\n", 'A' + i);
                        printf("Destination : %c\n", 'A' + j);

                        if(table[i].cost[j] == INF)
                            printf("Old Cost : INF\n");
                        else
                            printf("Old Cost : %d\n", table[i].cost[j]);

                        printf("New Cost : %d\n", newCost);
                        printf("Next Hop : %c\n", 'A' + k);
                        printf("Route Updated Successfully.\n");

                        table[i].cost[j] = newCost;
                        table[i].nextHop[j] = k;

                        updated = 1;
                    }
                }
                neighbor = neighbor->next;
            }
        }

        printf("\n==========================================");
        printf("\nRouting Tables After Iteration %d", iteration);
        printf("\n==========================================\n");

        displayRoutingTables();
        iteration++;

    } while(updated);

    printf("\n==========================================");
    printf("\nRouting Tables Converged.");
    printf("\nNo Further Updates Required.");
    printf("\n==========================================\n");
}

void displayRoutingTables()
{
    int i, j;
    for(i = 0; i < routers; i++)
    {
        printf("\nRouter %c\n", 'A' + i);
        printf("--------------------------------------\n");
        printf("Destination\tNext Hop\tCost\n");

        for(j = 0; j < routers; j++)
        {
            printf("%c\t\t", 'A' + j);

            if(table[i].nextHop[j] == -1)
                printf("-\t\t");
            else
                printf("%c\t\t", 'A' + table[i].nextHop[j]);

            if(table[i].cost[j] == INF)
                printf("INF\n");
            else
                printf("%d\n", table[i].cost[j]);
        }
        printf("--------------------------------------\n");
    }
}

void displayFinalTables()
{
    printf("\n\n==========================================");
    printf("\n       FINAL ROUTING TABLES");
    printf("\n==========================================\n");
    displayRoutingTables();
    printf("\n==========================================");
    printf("\nDistance Vector Routing Completed.");
    printf("\n==========================================\n");
}

// Clean up dynamically allocated nodes to avoid memory leaks
void freeGraph() 
{
    for (int i = 0; i < routers; i++) {
        struct Node* temp = adjList[i];
        while (temp != NULL) {
            struct Node* toDelete = temp;
            temp = temp->next;
            free(toDelete);
        }
    }
}
