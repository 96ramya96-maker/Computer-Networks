
#include <stdio.h>

int main() {
    int n, w, lost, base = 0, total = 0;
    int lossHandled = 0;

    printf("Enter number of frames: ");
    scanf("%d", &n);
    printf("Enter window size: ");
    scanf("%d", &w);
    printf("Enter frame number to lose (0 for none): ");
    scanf("%d", &lost);

    if (n <= 0 || w <= 0 || w > n ||
        lost < 0 || lost > n) {
        printf("Invalid input!\n");
        return 1;
    }

    while (base < n) {
        int end = base + w;
        if (end > n) end = n;

        printf("\nSending window: ");
        for (int i = base; i < end; i++) {
            printf("%d ", i + 1);
            total++;
        }
        printf("\n");

        int failed = -1;

        for (int i = base; i < end; i++) {
            int frame = i + 1;

            if (frame == lost && !lossHandled) {
                printf("Frame %d lost!\n", frame);
                lossHandled = 1;
                failed = i;
                break;
            }

            printf("ACK received for frame %d\n", frame);
        }

        if (failed != -1) {
            for (int i = failed + 1; i < end; i++)
                printf("Frame %d discarded by receiver.\n",
                       i + 1);

            printf("Timeout! Go-Back-N retransmits frames %d to %d\n",
                   failed + 1, end);

            for (int i = failed; i < end; i++) {
                printf("Retransmitting frame %d\n", i + 1);
                total++;
                printf("ACK received for frame %d\n", i + 1);
            }
        }

        base = end;
    }

    printf("\nAll frames delivered successfully.\n");
    printf("Total frame transmissions: %d\n", total);
    return 0;
}
