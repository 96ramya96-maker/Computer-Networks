#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 8080
#define BUFFER_SIZE 1024
#define GENERATOR "1101"

struct Node
{
    int frameNo;
    char data[300];
    struct Node *next;
};

struct Node *head = NULL;
struct Node *tail = NULL;

/* ---------- Circular Linked List ---------- */

void addFrame(int frameNo, char data[])
{
    struct Node *newNode = malloc(sizeof(struct Node));

    newNode->frameNo = frameNo;
    strcpy(newNode->data, data);

    if (head == NULL)
    {
        head = tail = newNode;
        newNode->next = head;
    }
    else
    {
        newNode->next = head;
        tail->next = newNode;
        tail = newNode;
    }
}

/* ---------- CRC ---------- */

void xorOperation(char a[], char b[], int start, int length)
{
    int i;

    for (i = 0; i < length; i++)
    {
        a[start + i] = (a[start + i] == b[i]) ? '0' : '1';
    }
}

int checkCRC(char codeword[])
{
    char temp[300];
    char generator[] = GENERATOR;

    int length = strlen(codeword);
    int generatorLength = strlen(generator);
    int i;

    strcpy(temp, codeword);

    for (i = 0; i <= length - generatorLength; i++)
    {
        if (temp[i] == '1')
            xorOperation(temp, generator, i, generatorLength);
    }

    for (i = length - generatorLength + 1; i < length; i++)
    {
        if (temp[i] == '1')
            return 0;
    }

    return 1;
}

/* ---------- Socket ---------- */

int createSocket()
{
    int sockfd;

    sockfd = socket(AF_INET, SOCK_DGRAM, 0);

    if (sockfd < 0)
    {
        perror("Socket creation failed");
        exit(1);
    }

    return sockfd;
}

void bindServer(int sockfd, struct sockaddr_in *server)
{
    server->sin_family = AF_INET;
    server->sin_port = htons(PORT);
    server->sin_addr.s_addr = INADDR_ANY;

    if (bind(sockfd, (struct sockaddr *)server,
             sizeof(*server)) < 0)
    {
        perror("Bind failed");
        exit(1);
    }
}

/* ---------- Receiver ---------- */

void runReceiver()
{
    int sockfd;
    struct sockaddr_in server, client;
    socklen_t length = sizeof(client);

    char codeword[BUFFER_SIZE];
    char reply[100];

    sockfd = createSocket();

    bindServer(sockfd, &server);

    printf("\nStop-and-Wait Receiver started...\n");

    while (1)
    {
        int bytes = recvfrom(sockfd, codeword, sizeof(codeword) - 1, 0,
                             (struct sockaddr *)&client, &length);

        if (bytes < 0)
        {
            perror("Receive failed");
            continue;
        }

        codeword[bytes] = '\0';

        printf("\nReceived Codeword: %s\n", codeword);

        if (checkCRC(codeword))
        {
            printf("CRC Check: PASSED\n");

            addFrame(0, codeword);

            strcpy(reply, "ACK");
            sendto(sockfd, reply, strlen(reply) + 1, 0,
                   (struct sockaddr *)&client, length);

            printf("ACK sent.\n");
        }
        else
        {
            printf("CRC Check: FAILED\n");
            printf("CRC Error detected!\n");

            strcpy(reply, "NACK");
            sendto(sockfd, reply, strlen(reply) + 1, 0,
                   (struct sockaddr *)&client, length);

            printf("NACK sent.\n");
        }
    }

    close(sockfd);
}

int main()
{
    runReceiver();

    return 0;
}
