#include <arpa/inet.h>
#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <sys/socket.h>
#include <netinet/in.h>
#define PORT 5200
int main(void){
 int s=socket(AF_INET,SOCK_STREAM,0);if(s<0){perror("socket");return 1;}
 struct sockaddr_in a={0};a.sin_family=AF_INET;a.sin_port=htons(PORT);inet_pton(AF_INET,"127.0.0.1",&a.sin_addr);
 if(connect(s,(struct sockaddr*)&a,sizeof a)<0){perror("connect");return 1;}
 char b[1024],r[1024];while(1){printf("Message (exit to quit): ");if(!fgets(b,sizeof b,stdin))break;send(s,b,strlen(b),0);ssize_t n=recv(s,r,sizeof r-1,0);if(n<=0)break;r[n]=0;printf("Echo: %s",r);if(strstr(b,"exit"))break;}close(s);return 0;
}
